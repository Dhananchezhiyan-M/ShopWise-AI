# ShopWise AI - Environment Configuration Template

# Application
PROJECT_NAME="ShopWise AI"
API_V1_STR="/api"
ENVIRONMENT="development"
PORT=8000

# CORS Origins (Allowed frontend URLs)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Database URL (SQLite default, easily changed to postgresql://user:pass@localhost:5432/shopwise)
DATABASE_URL="sqlite:///./shopwise.db"

# ChromaDB Vector Store Directory
CHROMA_PERSIST_DIR="./data/chroma_db"

# Google Gemini API Key
# Obtain your free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Gemini Model Name
GEMINI_MODEL_NAME="gemini-1.5-flash"
